{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 (CMSIS-DAP / OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/STM32F103MIN.elf",
            "servertype": "openocd",
            "serverpath": "D:/STM32Toolchain/openocd/bin/openocd.exe",
            "device": "STM32F103C8",
            "interface": "swd",
            "searchDir": [
                "D:/STM32Toolchain/openocd/openocd/scripts"
            ],
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f1x.cfg"
            ],
            "openOCDLaunchCommands": [
                "adapter speed 4000"
            ],
            "svdFile": "${workspaceFolder}/STM32F103.svd",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "preLaunchTask": "build"
        }
    ]
}
